rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Storage güvenlik kuralları
//
// Fotoğraflar couples/{coupleId}/{tür}/{dosya} yolunda durur.
// Sadece o çiftin üyeleri yükleyebilir, okuyabilir, silebilir.
// Yüklenen dosya görsel olmalı ve 3 MB'tan küçük olmalı.
//
// Yayınlamak: firebase deploy --only storage
// ─────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isMember(coupleId) {
      return request.auth != null
        && request.auth.uid in
           firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }

    match /couples/{coupleId}/{allPaths=**} {

      allow read: if isMember(coupleId);

      allow create, update: if isMember(coupleId)
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isMember(coupleId);
    }

  }
}
